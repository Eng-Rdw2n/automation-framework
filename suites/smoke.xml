<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd" >

<!--
    Run the API block and the UI block at the same time.
    Classes inside each block stay sequential, which keeps the public sandbox stable.
    This suite contains only the critical smoke journeys documented in docs/test-cases.md.
-->
<suite name="Smoke Suite" parallel="tests" thread-count="2" data-provider-thread-count="1">

    <listeners>
          <!-- Custom logging + screenshot + environment info -->
        <listener class-name="com.radwanalbunni.automation.core.listeners.TestListener"/>
          <!-- Automatically applies RetryAnalyzer to every @Test method -->
       <listener class-name="com.radwanalbunni.automation.core.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Smoke API">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
            <class name="com.radwanalbunni.tests.api.LoginApiTest"/>
            <class name="com.radwanalbunni.tests.api.RegistrationApiTest"/>
            <class name="com.radwanalbunni.tests.api.AccountApiTest"/>
        </classes>
    </test>

    <test name="Smoke UI">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <classes>
            <class name="com.radwanalbunni.tests.ui.LoginUiTest"/>
            <class name="com.radwanalbunni.tests.ui.RegistrationUiTest"/>
            <class name="com.radwanalbunni.tests.ui.CartUiTest"/>
            <class name="com.radwanalbunni.tests.ui.CheckoutUiTest"/>
        </classes>
    </test>

</suite>
