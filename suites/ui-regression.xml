<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd">

<!-- Two UI test classes run together; methods inside a class remain sequential. -->
<suite name="UI Regression Suite" parallel="classes" thread-count="2" data-provider-thread-count="1">

    <listeners>
        <listener class-name="com.radwanalbunni.automation.core.listeners.TestListener"/>
        <listener class-name="com.radwanalbunni.automation.core.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="UI regression">
        <classes>
            <class name="com.radwanalbunni.tests.ui.LoginUiTest"/>
            <class name="com.radwanalbunni.tests.ui.RegistrationUiTest"/>
            <class name="com.radwanalbunni.tests.ui.SearchUiTest"/>
            <class name="com.radwanalbunni.tests.ui.CartUiTest"/>
            <class name="com.radwanalbunni.tests.ui.CheckoutUiTest"/>
            <class name="com.radwanalbunni.tests.ui.ContactUsUiTest"/>
            <class name="com.radwanalbunni.tests.ui.ReviewUiTest"/>
            <class name="com.radwanalbunni.tests.ui.SubscriptionUiTest"/>
        </classes>
    </test>
</suite>
